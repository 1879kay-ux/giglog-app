{
  "expo": {
    "name": "GigSynq",
    "slug": "Giglog",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "giglog",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D9488"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.giglogtracker.app",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0D9488"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.giglogtracker.app",
      "versionCode": 3,
      "blockedPermissions": ["android.permission.CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
  "plugins": [
  "expo-router",
  "@react-native-community/datetimepicker",
  [
    "expo-image-picker",
    {
      "cameraPermission": false
    }
  ],
  [
    "expo-notifications",
    {
      "icon": "./assets/icon.png",
      "color": "#0D9488"
    }
  ],
  "expo-localization",
  "expo-web-browser"
],

      "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fca14bbf-1686-453d-9562-0bbdf31a2f5c"
      }
    }
  }
}
